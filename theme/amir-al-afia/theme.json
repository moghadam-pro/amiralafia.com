{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "primary",     "color": "#018ED5", "name": "Primary" },
				{ "slug": "primary-ink", "color": "#016FA6", "name": "Primary deep" },
				{ "slug": "secondary",   "color": "#38B6FF", "name": "Secondary" },
				{ "slug": "abyss",       "color": "#002537", "name": "Deep" },
				{ "slug": "ink",         "color": "#111827", "name": "Ink" },
				{ "slug": "muted",       "color": "#5A6473", "name": "Muted" },
				{ "slug": "mist",        "color": "#F2F8FC", "name": "Mist" },
				{ "slug": "white",       "color": "#FFFFFF", "name": "White" }
			]
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Jost",
					"fontFamily": "'Jost', system-ui, sans-serif"
				},
				{
					"slug": "display",
					"name": "Italiana",
					"fontFamily": "'Italiana', 'Times New Roman', serif"
				}
			],
			"fontSizes": [
				{ "slug": "small",  "size": "13px",   "name": "Small" },
				{ "slug": "medium", "size": "15.5px", "name": "Medium" },
				{ "slug": "large",  "size": "22px",   "name": "Large" }
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"units": [ "px", "rem", "%" ]
		}
	},
	"styles": {
		"color": {
			"background": "#FFFFFF",
			"text": "#111827"
		},
		"typography": {
			"fontFamily": "'Jost', system-ui, sans-serif",
			"fontSize": "15.5px",
			"lineHeight": "1.75"
		},
		"elements": {
			"link": {
				"color": { "text": "#016FA6" }
			},
			"heading": {
				"typography": {
					"fontFamily": "'Italiana', 'Times New Roman', serif",
					"fontWeight": "400",
					"textTransform": "uppercase"
				}
			}
		}
	}
}
